<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!--
        Definición del bean Grupo sin inyectar propiedades.
        El contenedor IoC administra el ciclo de vida del objeto y
        la asignación de valores se realizará posteriormente desde Java.
    -->
    <bean id="grupoBean" class="com.accenture.model.Grupo" />

</beans>
